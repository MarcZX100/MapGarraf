PORT=4174
DATABASE_PATH=./data/busgarraf.sqlite
# Set to the number of trusted reverse proxies (for example 1 behind one proxy).
TRUST_PROXY=0
MAX_GPS_ACCURACY_METERS=1000
MAX_NEW_REPORTS_PER_MINUTE_PER_IP=30
MAX_WRITES_PER_MINUTE_PER_IP=300
MAX_ACTIVE_REPORTS_PER_DIRECTION=60
# Switch to a contracted/self-hosted tile provider before scaling traffic.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
